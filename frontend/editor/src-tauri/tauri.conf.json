{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "GSI PDF",
  "mainBinaryName": "GSI-PDF",
  "version": "2.14.3",
  "identifier": "gsi.pdf.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npx vite --mode desktop",
    "beforeBuildCommand": "npx vite build --mode desktop"
  },
  "app": {
    "windows": [
      {
        "title": "GSI PDF",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "visible": true,
        "transparent": false,
        "backgroundColor": "#FFFFFF",
        "dragDropEnabled": false,
        "additionalBrowserArgs": "--enable-features=CertVerifierBuiltinFeature"
      }
    ]
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "publisher": "GSI",
    "targets": ["deb", "rpm", "appimage", "dmg", "app", "msi"],
    "icon": [
      "icons/windows/app.ico",
      "icons/macos/app.icns",
      "icons/macos/app-512.png"
    ],
    "resources": ["libs/*.jar", "runtime/jre/**/*", "runtime/tools/**/*"],
    "fileAssociations": [
      {
        "ext": ["pdf"],
        "name": "PDF Document",
        "role": "Editor",
        "mimeType": "application/pdf"
      }
    ],
    "linux": {
      "deb": {
        "desktopTemplate": "gsi-pdf.desktop"
      },
      "rpm": {
        "desktopTemplate": "gsi-pdf.desktop",
        "compression": { "type": "zstd", "level": 3 }
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com",
      "wix": {
        "upgradeCode": "9e6f2090-b439-404a-a4dd-8acb42c710ba",
        "bannerPath": "windows/wix/banner.bmp",
        "dialogImagePath": "windows/wix/dialog.bmp",
        "fragmentPaths": ["windows/wix/provisioning.wxs"],
        "componentGroupRefs": ["ProvisioningComponentGroup"]
      }
    },
    "macOS": {
      "dmg": {
        "background": "macos/dmg/background.png",
        "windowSize": { "width": 660, "height": 400 },
        "appPosition": { "x": 200, "y": 210 },
        "applicationFolderPosition": { "x": 460, "y": 210 }
      },
      "minimumSystemVersion": "10.15",
      "signingIdentity": null,
      "entitlements": null,
      "providerShortName": null,
      "infoPlist": "Info.plist"
    }
  },
  "plugins": {
    "shell": {
      "open": true
    },
    "fs": {
      "requireLiteralLeadingDot": false
    },
    "deep-link": {
      "desktop": {
        "schemes": ["gsipdf"]
      }
    },
    "updater": {
      "endpoints": [
        "https://github.com/Stirling-Tools/Stirling-PDF/releases/latest/download/latest.json"
      ],
      "dialog": false,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZEREM2QTgwNjdGNzdCOUQKUldTZGUvZG5nR3JjYmZ4TlZ3YVpHTVIzd2hBT2c4c000RDNIN2tLZENEblE4ZXFhU3J5V0lQanEK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
